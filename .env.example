# 로컬 실행용 환경 변수. `.env` 또는 `.env.dev`로 복사해 값을 채운다. 실제 값은 커밋하지 않는다.

LOG_LEVEL=INFO
# 실행 환경(dev, prod). Sentry environment에 표시한다. 비우면 local
ENV=
# buddybird-audio-ai Sentry 프로젝트 DSN. 비우면 Sentry로 보내지 않는다
SENTRY_DSN=

AWS_DEFAULT_REGION=
# 소리와 기준음성 버킷
S3_BUCKET=

# 결과 큐 URL. 필수
SQS_JUDGMENT_RESULT_QUEUE_URL=
# 로컬 elasticmq 주소. 실제 AWS 큐를 사용할 때는 비운다
SQS_ENDPOINT_URL=
